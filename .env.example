# Required: OpenAI API key for embeddings
OPENAI_API_KEY=sk-your-openai-api-key-here

# Recommended: Anthropic API key for chat (uses Claude)
# If not set, will fall back to OpenAI GPT-4o
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# Optional: Force using OpenAI for chat even if Anthropic key is set
# LLM_PROVIDER=openai

# Server port (default: 3001)
PORT=3001
